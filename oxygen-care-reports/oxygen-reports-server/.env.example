# Local database supplied by compose.yaml. Change every placeholder before hosting.
DATABASE_URL=postgres://oxygen_care:change_this_local_password@localhost:5432/oxygen_care_reports
DATABASE_SSL=disable
SESSION_SECRET=replace_with_a_random_32_byte_or_longer_value
APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Other addresses the app is also served on, comma separated (for example a public domain).
# APP_EXTRA_ORIGINS=https://reports.example.com

# Production-only integrations. Do not expose these values to the browser.
SMTP_URL=smtp://username:password@mail.example.com:587
STORAGE_ENDPOINT=
STORAGE_BUCKET=oxygen-care-reports
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MFA_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key
