# Local database supplied by compose.yaml. Change every placeholder before hosting.
DATABASE_URL=postgres://oxygen_care:change_this_local_password@localhost:5432/oxygen_care_reports
DATABASE_SSL=disable
SESSION_SECRET=replace_with_a_random_32_byte_or_longer_value
APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Other addresses the app is also served on, comma separated (for example a public domain).
# APP_EXTRA_ORIGINS=https://reports.example.com

# Production-only integrations. Do not expose these values to the browser.
# Customer sign-in codes are emailed through this mailbox (smtps on port 465; "@" in the
# username is written %40). MAIL_FROM is the sender customers see.
SMTP_URL=smtps://no-reply%40example.com:password@mail.example.com:465
MAIL_FROM=Irish Hospital Supplies Reports <no-reply@example.com>
STORAGE_ENDPOINT=
STORAGE_BUCKET=oxygen-care-reports
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Encrypts staff authenticator keys: 32 random bytes, base64 (openssl rand -base64 32).
# Never change it once staff have set up their authenticator.
MFA_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key
