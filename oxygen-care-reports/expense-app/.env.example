# Keep this file private. Never place the API key in the browser or commit it.
# Tesseract is the local primary OCR provider. RapidOCR, then Azure (if allowed), are used only if it fails.
OCR_PROVIDER=tesseract
# RapidOCR is the local failover if Tesseract cannot read a receipt (installed by the deploy
# script). Leave unset to use the default location, or set to off to disable it.
# RAPIDOCR_PYTHON=/home/serveradmin/oxygen-care-expenses-rapidocr/bin/python3
OCR_ALLOW_CLOUD=false
# Azure fallback: create a Document Intelligence resource, then copy Keys and Endpoint values here.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-server-side-key
PORT=3000
# Security controls. Keep defaults for the private demo; lower limits if access is shared.
LOGIN_RATE_LIMIT=10
# Restart-resistant account/IP lockout after repeated failed sign-ins.
ACCOUNT_FAILURE_LIMIT=5
ACCOUNT_LOCK_MINUTES=15
# Sign users out after this many minutes without activity (5–720; default 20).
SESSION_IDLE_MINUTES=20
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_ARCHIVES=12
OCR_RATE_LIMIT=8
OCR_DAILY_LIMIT=20
OCR_MAX_CONCURRENT=2
OCR_TIMEOUT_MS=45000
# Total receipt storage ceiling (default 2 GiB).
RECEIPT_STORAGE_MAX_BYTES=2147483648
# Required on first launch. This account can create regular users.
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=replace-with-a-unique-12-character-minimum-password
# Leave blank normally. Set temporarily to reset the existing Super User password,
# then remove it and restart the server.
RESET_SUPERUSER_PASSWORD=
