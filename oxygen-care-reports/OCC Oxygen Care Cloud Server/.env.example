# Docker Compose reads this. Native systemd installation writes its own protected environment.
APP_ORIGIN=https://occ.example.com
# Other addresses OCC is also served on, comma separated (for example a public domain).
# APP_EXTRA_ORIGINS=https://cloud.example.com
# Encrypts staff authenticator keys (32 bytes, base64): openssl rand -base64 32
# Never change it once people have signed in, or everyone sets up their authenticator again.
MFA_ENCRYPTION_KEY=
MAX_FILE_BYTES=100000000
STORAGE_QUOTA_BYTES=5000000000
